OZON_CLIENT_ID=
OZON_API_KEY=
# Path (dotted) inside financial_data.products[] to the amount paid by the buyer.
# Recommended: customer_price (a number in /v3/posting/fbs/get, {amount,currency} in the v4
# list; both are handled; matches "Оплачено покупателем" in the cabinet,
# verified live for quantity 1). Leave empty: orders then go to a human.
OZON_PAID_FIELD=customer_price
# Is that value per unit (true) or already the line total (false)? NOT verified for
# quantity > 1. Leave empty: lines with quantity > 1 go to a human.
OZON_PAID_IS_UNIT=
# Yandex Market: Partner API token (one for the whole business) and business id (needed for
# brands). The shops (campaigns) come from the `yandex` section of warehouses.yaml.
YM_TOKEN=
# Optional: restrict the robot to this single campaign. Leave empty to use all listed ones.
YM_CAMPAIGN_ID=
YM_BUSINESS_ID=
# Item field with the buyer's price. Recommended: buyerPrice. It is PER UNIT (verified live
# with count 2); the robot multiplies
# by count. Never guessed: leave empty and orders go to a human.
YM_PAID_FIELD=buyerPrice
# Wildberries API token (orders). Empty: WB is not connected.
WB_TOKEN=
# WB order field with the buyer's price (kopecks): price, salePrice, convertedPrice or
# finalPrice. Empty: every WB order goes to a person.
WB_PAID_FIELD=price
# Name of this (main) company in order messages, «Озон · Альфа». Empty: Альфа.
COMPANY_NAME=
# Second company «Бета»: its own Ozon and Yandex Market keys; the paid-field
# settings above are shared. Empty: Бета is not connected and the robot runs as before.
# Its warehouses: sections ozon_second / yandex_second of warehouses.yaml
# (python -m orderbot.recon warehouses second lists them).
SECOND_COMPANY_NAME=Бета
SECOND_OZON_CLIENT_ID=
SECOND_OZON_API_KEY=
SECOND_YM_TOKEN=
SECOND_YM_BUSINESS_ID=
# Part of the title of the Microsoft Remote Desktop window with 1C. Leave empty if the app
# has only that one window open; with several windows and no filter the robot stops.
RDP_WINDOW_TITLE_CONTAINS=
# Seconds without mouse or keyboard use on the Mac before the robot types or clicks.
# At least 10.
IDLE_MIN_SECONDS=30
BOT_TOKEN=
ALLOWED_USER_IDS=
# Managers: only the buttons under order messages in the group. They get nothing without
# ALERT_CHAT_ID.
MANAGER_USER_IDS=
# Telegram group for order messages (negative, -100...) and its topic «Заказы [WB / OZON / YM]»
# (message_thread_id). Empty: order messages go to every admin privately.
ALERT_CHAT_ID=
ALERT_THREAD_ID=
# Lamoda FBS labels: orders «Ждёт отгрузки» with their PDF labels go to this
# topic of the ALERT_CHAT_ID group. Any of the three empty: the labels are off.
LAMODA_CLIENT_ID=
LAMODA_CLIENT_SECRET=
LAMODA_THREAD_ID=
# Shipment reminders: 10 min before each handover the counts go to this topic
# of the ALERT_CHAT_ID group. Times and warehouses: SHIPMENTS_FILE (default shipments.yaml).
SHIPMENTS_THREAD_ID=
# Topic of the ALERT_CHAT_ID group for API and 1C failures. Empty: they go to the admins.
HEALTH_THREAD_ID=
SHIPMENTS_FILE=shipments.yaml
WAREHOUSES_FILE=warehouses.yaml
# Screen layout file of the operator's 1C window (made with the calibration tool).
LAYOUT_FILE=layouts/production.yaml
# Articles with a fixed price (ARTICLE PRICE per line). Default: price_exceptions.txt.
PRICE_EXCEPTIONS_FILE=price_exceptions.txt
# Where the database, snapshots and the lock file live.
DATA_DIR=data
